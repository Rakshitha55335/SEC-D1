# Python program to demonstrate identity operators

# Creating variables
a = [10, 20, 30]
b = a
c = [10, 20, 30]

print("Value of a:", a)
print("Value of b:", b)
print("Value of c:", c)

print("\nUsing 'is' Operator")
print("a is b:", a is b)
print("a is c:", a is c)

print("\nUsing 'is not' Operator")
print("a is not b:", a is not b)
print("a is not c:", a is not c)