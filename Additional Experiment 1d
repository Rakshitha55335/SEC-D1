# Python program to demonstrate dynamic typing

# Integer value
x = 100
print("Value of x:", x)
print("Data Type:", type(x))
print("-" * 30)

# Float value
x = 45.75
print("Value of x:", x)
print("Data Type:", type(x))
print("-" * 30)

# String value
x = "Python Programming"
print("Value of x:", x)
print("Data Type:", type(x))
print("-" * 30)

# Boolean value
x = True
print("Value of x:", x)
print("Data Type:", type(x))